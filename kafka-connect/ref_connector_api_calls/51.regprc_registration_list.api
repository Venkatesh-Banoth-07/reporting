# these following will be taken from env
#DB_USER=
#DB_PORT=
#DB_HOSTNAME=
#DB_PASS=
#DB_PREFIX_INDEX=
#ES_URL=

CONN_NAME="regprc_registration_list_$DB_PREFIX_INDEX"; # change this.. give unique name for each db/table

ES_CONN_URL='es-connect:8083'; # needn't change .. this is the ES-connector service name

DB_NAME='mosip_regprc'; # change this
DB_TABLES='regprc.registration_list'
ES_INDICES=$(echo $DB_TABLES | sed -E "s/([^,]+)/$DB_PREFIX_INDEX.\1/g")

curl \
  -X POST \
  http://$ES_CONN_URL/connectors \
  -H 'Content-Type: application/json' \
  -d \
  '{
      "name": '\"$CONN_NAME\"',
      "config": {
          "connector.class": "io.confluent.connect.elasticsearch.ElasticsearchSinkConnector",
          "name": '\"$CONN_NAME\"',
          "connection.url": '\"$ES_URL\"',
          "tasks.max": "1",
          "topics": '\"$ES_INDICES\"',
          "key.ignore": "false",
          "schema.ignore": "true",
          "key.converter": "org.apache.kafka.connect.storage.StringConverter",
          "value.converter": "org.apache.kafka.connect.json.JsonConverter",
          "key.converter.schemas.enable": "false",
          "value.converter.schemas.enable": "true",

          "behavior.on.null.values": "DELETE",

          "errors.tolerance": "all",
          "errors.log.enable": "true",
          "drop.tombstones": "false",
          "errors.log.include.messages": "true",
          "behavior.on.version.conflict": "ignore",
          "errors.deadletterqueue.topic.name": '\"dlq-$ES_INDICES\"',
          "producer.metrics.recording.level": "INFO",
          "errors.deadletterqueue.context.headers.enable": "true",
          "behavior.on.malformed.documents": "IGNORE",
          "use.event.time.ordering": "true",

          "transforms": "debezExtract,tsconvert01,tsconvert02,tsconvert03,tsconvert04,refSplit,enrichFromM,enrichFromZ,tsSelect",

          "transforms.debezExtract.type": "io.debezium.transforms.ExtractNewRecordState",
          "transforms.debezExtract.delete.handling.mode": "drop",
          "transforms.debezExtract.drop.tombstones": "false",
          "transforms.debezExtract.add.fields": "source.ts_ms:ts_ms,table,lsn",
          "transforms.debezExtract.add.fields.prefix": "source_",

          "transforms.tsconvert01.type": "io.mosip.kafka.connect.transforms.TimestampConverterAdv$Value",
          "transforms.tsconvert01.field": "source_ts_ms",

          "transforms.tsconvert02.type": "io.mosip.kafka.connect.transforms.TimestampConverterAdv$Value",
          "transforms.tsconvert02.field": "cr_dtimes",
          "transforms.tsconvert02.input.type": "micro_sec",

          "transforms.tsconvert03.type": "io.mosip.kafka.connect.transforms.TimestampConverterAdv$Value",
          "transforms.tsconvert03.field": "upd_dtimes",
          "transforms.tsconvert03.input.type": "micro_sec",

          "transforms.tsconvert04.type": "io.mosip.kafka.connect.transforms.TimestampConverterAdv$Value",
          "transforms.tsconvert04.field": "del_dtimes",
          "transforms.tsconvert04.input.type": "micro_sec",

          "transforms.refSplit.type": "io.mosip.kafka.connect.transforms.RefIdSplitter$Value",
          "transforms.refSplit.input.field": "ref_id",
          "transforms.refSplit.output.fields": "regcntr_id,machine_id",

          "transforms.enrichFromM.type": "io.mosip.kafka.connect.transforms.DynamicNewField$Value",
          "transforms.enrichFromM.es.index": '\"$DB_PREFIX_INDEX.master.machine_master\"',
          "transforms.enrichFromM.es.url": '\"$ES_URL\"',
          "transforms.enrichFromM.input.fields": "machine_id",
          "transforms.enrichFromM.input.default.values": "machine_id",
          "transforms.enrichFromM.es.input.fields": "id",
          "transforms.enrichFromM.es.output.field": "zone_code",
          "transforms.enrichFromM.output.field": "zone_code",

          "transforms.enrichFromZ.type": "io.mosip.kafka.connect.transforms.DynamicNewField$Value",
          "transforms.enrichFromZ.es.index": '\"$DB_PREFIX_INDEX.master.zone\"',
          "transforms.enrichFromZ.es.url": '\"$ES_URL\"',
          "transforms.enrichFromZ.input.fields": "zone_code",
          "transforms.enrichFromZ.input.default.values": "zone_code",
          "transforms.enrichFromZ.es.input.fields": "code",
          "transforms.enrichFromZ.es.output.field": "name",
          "transforms.enrichFromZ.output.field": "zone_name",

          "transforms.tsSelect.type": "io.mosip.kafka.connect.transforms.TimestampSelector$Value",
          "transforms.tsSelect.ts.order": "cr_dtimes,upd_dtimes,source_ts_ms",
          "transforms.tsSelect.output.field": "@timestamp_gen"
      }
}';
